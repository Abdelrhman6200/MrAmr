# Copy to .env and fill in before `docker compose up -d`.
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_NAME=Your Name
AUTH_SECRET=
TZ=Africa/Cairo
TRUST_PROXY=
# Public address of the app, used in email links (required for email password resets).
APP_URL=https://tasks.yourcompany.com
# Optional: an email account to send password resets and notifications from.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TaskFlow <tasks@yourcompany.com>
