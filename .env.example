# The settings TaskFlow reads. On Vercel, add them under Project → Settings →
# Environment Variables. For local development you can copy this file to .env
# (npm start / npm run dev read it); leave DATABASE_URL empty to use the
# built-in local database instead of Supabase.

# Supabase → Connect → Transaction pooler (port 6543). Contains your database password: keep it secret.
DATABASE_URL=
# Signs sign-in sessions. Any long random string, e.g. from: openssl rand -hex 32
AUTH_SECRET=
# The first Head of Company account, created once when the database is empty.
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_NAME=Your Name
# "Today", overdue and call-back times are worked out in this time zone.
APP_TIMEZONE=Africa/Cairo

# Optional: the public address used in email links (on Vercel it defaults to the production domain).
APP_URL=
# Optional: an email account to send password resets and notifications from.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TaskFlow <tasks@yourcompany.com>
# Optional: protects the daily email retry job (Vercel sends it automatically).
CRON_SECRET=
